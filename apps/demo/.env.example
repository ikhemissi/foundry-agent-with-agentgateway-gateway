DEMO_AUTH_MODE=certificate
DEMO_TENANT_ID=<tenant-id>
DEMO_SPA_CLIENT_ID=<dedicated-spa-client-id>
DEMO_BLUEPRINT_CLIENT_ID=<hosted-agent-parent-blueprint-app-id>
HOSTED_AGENT_PRINCIPAL_ID=<hosted-agent-identity-id>
AZURE_PRINCIPAL_ID=<authorized-human-object-id>
AGENTGATEWAY_ENTRA_CLIENT_ID=<gateway-api-client-id>
CONSUMER_FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AGENTGATEWAY_ENDPOINT=https://<gateway>.<region>.azurecontainerapps.io
DEMO_ORIGIN=http://localhost:3000
DEMO_USER_SCOPE=access_agent_as_user
DEMO_CERTIFICATE_PATH=/absolute/path/to/.certificates/demo.pem
DEMO_PRIVATE_KEY_PATH=/absolute/path/to/.certificates/demo.key
