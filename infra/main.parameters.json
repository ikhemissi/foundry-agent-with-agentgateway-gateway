{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "location": {
      "value": "${AZURE_LOCATION=eastus}"
    },
    "modelCapacity": {
      "value": "${MODEL_CAPACITY=10}"
    },
    "gatewayEntraClientId": {
      "value": "${AGENTGATEWAY_ENTRA_CLIENT_ID}"
    },
    "hostedAgentPrincipalId": {
      "value": "${HOSTED_AGENT_PRINCIPAL_ID=}"
    },
    "promptGatewayClientId": {
      "value": "${PROMPT_GATEWAY_CLIENT_ID}"
    },
    "promptGatewayPrincipalId": {
      "value": "${PROMPT_GATEWAY_PRINCIPAL_ID}"
    },
    "promptGatewayClientSecret": {
      "value": "${PROMPT_GATEWAY_CLIENT_SECRET}"
    },
    "tags": {
      "value": {
        "CostControl": "Ignore",
        "SecurityControl": "Ignore"
      }
    }
  }
}
