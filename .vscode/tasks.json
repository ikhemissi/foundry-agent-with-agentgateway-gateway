{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test project scaffold",
      "type": "process",
      "command": "node",
      "args": ["--test", "tests/agent.test.mjs", "tests/deployment.test.mjs", "tests/migration.test.mjs", "tests/demo-entra.test.mjs", "tests/demo-hosting.test.mjs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Test infrastructure contracts",
      "type": "process",
      "command": "node",
      "args": ["--test", "tests/infra.test.mjs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test gateway compatibility",
      "type": "process",
      "command": "node",
      "args": ["--test", "tests/gateway.test.mjs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run CopilotKit demo",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/apps/demo",
        "env": { "NEXT_TELEMETRY_DISABLED": "1" }
      },
      "problemMatcher": []
    },
    {
      "label": "Test CopilotKit demo",
      "type": "process",
      "command": "npm",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}/apps/demo" },
      "problemMatcher": []
    },
    {
      "label": "Preview demo Entra setup",
      "type": "process",
      "command": "node",
      "args": ["scripts/configure-demo-entra.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Validate hosted tutor ports",
      "type": "aitk",
      "command": "debug-check-prerequisites",
      "args": {
        "portOccupancy": [5679, 8088]
      }
    },
    {
      "label": "Run hosted tutor HTTP server",
      "type": "shell",
      "command": "azd ai agent run ai-tutor-hosted-agent --no-client --start-command '.venv/bin/python -Xfrozen_modules=off -m debugpy --listen 127.0.0.1:5679 main.py'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Validate hosted tutor ports",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^.*$",
            "file": 0,
            "location": 1,
            "message": 2
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Application startup complete|[Rr]unning on|Started server process"
        }
      }
    },
    {
      "label": "Open hosted tutor Inspector",
      "type": "shell",
      "command": "echo '${input:openAgentInspector}'",
      "dependsOn": "Run hosted tutor HTTP server",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openAgentInspector",
      "type": "command",
      "command": "ai-mlstudio.openTestTool",
      "args": {
        "triggeredFrom": "tasks",
        "port": 8088
      }
    }
  ]
}
